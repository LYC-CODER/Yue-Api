<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lycorder</groupId>
    <artifactId>Yue-Api</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <modules>
        <module>yue-common</module>
        <module>yue-core</module>
        <module>yue-security</module>
        <module>yue-plugin</module>
        <module>yue-system</module>
        <module>yue-auth</module>
        <module>yue-platform</module>
        <module>yue-boot</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <hutool.version>5.8.41</hutool.version>
        <mysql.verison>8.0.30</mysql.verison>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <druid.version>1.2.24</druid.version>
        <knife4j.version>4.5.0</knife4j.version>
        <minio.version>8.5.10</minio.version>
        <fastexcel.version>1.3.0</fastexcel.version>
        <fastjson.version>2.0.50</fastjson.version>
        <ip2region.version>2.7.0</ip2region.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <redisson.version>3.51.0</redisson.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <caffeine.version>2.9.3</caffeine.version>
        <springdoc.version>2.8.9</springdoc.version>
        <swagger-annotations.version>2.2.36</swagger-annotations.version>
    </properties>

    <!-- 内部模块版本统一管理 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.lycorder</groupId>
                <artifactId>yue-common</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.lycorder</groupId>
                <artifactId>yue-core</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.lycorder</groupId>
                <artifactId>yue-security</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.lycorder</groupId>
                <artifactId>yue-plugin</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.lycorder</groupId>
                <artifactId>yue-system</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.lycorder</groupId>
                <artifactId>yue-auth</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.lycorder</groupId>
                <artifactId>yue-platform</artifactId>
                <version>1.0-SNAPSHOT</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
